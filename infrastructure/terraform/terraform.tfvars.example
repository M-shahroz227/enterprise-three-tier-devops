aws_region   = "ap-south-1"
project_name = "enterprise-three-tier"
environment  = "dev"

vpc_cidr = "10.0.0.0/16"

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

kubernetes_version = "1.35"

cluster_endpoint_public_access_cidrs = ["YOUR_PUBLIC_IP/32"]

node_instance_types = ["t3.small"]
node_desired_size   = 1
node_min_size       = 1
node_max_size       = 1
node_disk_size      = 20